# =============================================================================
# MOSY — Environment Variables Template
# Copy to .env.local and fill in values. NEVER commit .env.local.
# =============================================================================

# --- Azure General ---
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=rg-mosy-dev

# --- Azure IoT Hub ---
AZURE_IOT_HUB_NAME=mosy-iothub-dev
AZURE_IOT_HUB_CONNECTION_STRING=
AZURE_IOT_DEVICE_CONNECTION_STRING=

# --- Azure Cosmos DB ---
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=mosydb

# --- Azure Blob Storage ---
AZURE_STORAGE_ACCOUNT=mosystoragedev
AZURE_STORAGE_CONNECTION_STRING=

# --- Azure Functions ---
AZURE_FUNCTIONS_APP_NAME=mosy-functions-dev

# --- Azure SignalR ---
AZURE_SIGNALR_CONNECTION_STRING=

# --- Azure Key Vault ---
AZURE_KEYVAULT_NAME=mosy-kv-dev

# --- Microsoft Entra External ID ---
AZURE_ENTRA_TENANT_ID=
AZURE_ENTRA_CLIENT_ID_ADMIN=
AZURE_ENTRA_CLIENT_ID_OPERATOR=
AZURE_ENTRA_AUTHORITY=

# --- Azure Communication Services (WhatsApp/SMS) ---
AZURE_COMMUNICATION_CONNECTION_STRING=

# --- Mapbox ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Edge / MQTT ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_WS_PORT=9001

# --- Edge Device ---
CRANE_ID=POC-001
SITE_ID=SITE-POC
