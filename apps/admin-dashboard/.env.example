# MOSY Admin Dashboard Environment Variables

# Demo Mode — set to 'true' for client demos without Azure backend
NEXT_PUBLIC_DEMO_MODE=true

# Azure MSAL Authentication
NEXT_PUBLIC_MSAL_CLIENT_ID=
NEXT_PUBLIC_MSAL_AUTHORITY=https://login.microsoftonline.com/common
NEXT_PUBLIC_MSAL_REDIRECT_URI=http://localhost:3000

# Azure SignalR Service
SIGNALR_SERVICE_URL=

# Azure Functions Backend
NEXT_PUBLIC_API_BASE_URL=
