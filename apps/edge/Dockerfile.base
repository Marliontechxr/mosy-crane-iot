# =============================================================================
# MOSY — Base Docker Image for Edge Services (x86 POC)
# Python 3.11 with common dependencies for all services.
# =============================================================================
FROM python:3.11-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY apps/edge/requirements.base.txt /tmp/requirements.base.txt
RUN pip install --no-cache-dir -r /tmp/requirements.base.txt && rm /tmp/requirements.base.txt

# Install mosy-schemas from workspace
COPY packages/mqtt-schemas/python /tmp/mosy-schemas
RUN pip install --no-cache-dir /tmp/mosy-schemas && rm -rf /tmp/mosy-schemas

# Copy shared utilities
COPY apps/edge/services/shared /app/shared

# Create data directory for SQLite before switching to non-root
RUN mkdir -p /app/data

# Non-root user
RUN useradd --create-home --shell /bin/bash mosy \
    && chown -R mosy:mosy /app
USER mosy

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
