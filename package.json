{
  "name": "mosy-crane-iot",
  "version": "0.1.0",
  "private": true,
  "description": "MOSY — Mobile Crane Operator Safety & Productivity System",
  "author": "Balanetra Technologies",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "demo": "bash scripts/demo-start.sh",
    "simulate": "python tools/sensor-simulator/main.py --scenario full-demo",
    "validate": "bash scripts/poc-validate.sh --demo",
    "deploy:infra": "bash infra/scripts/deploy.sh",
    "deploy:functions": "cd functions && func azure functionapp publish mosy-functions-dev",
    "deploy:dashboard": "cd apps/admin-dashboard && pnpm build"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.7.0",
    "eslint": "^8.57.0",
    "prettier": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0"
  }
}
